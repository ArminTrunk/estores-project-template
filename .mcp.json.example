{
  "_hinweis": "Kopiere zu .mcp.json (gitignored) und trage echte Tokens via Env ein (${VAR}-Expansion wird von Claude Code unterstützt). Nur benötigte Server behalten.",
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    },
    "storyblok": {
      "type": "http",
      "url": "https://mcp.labs.storyblok.com",
      "_hinweis": "EU-Region für DSGVO"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      },
      "_hinweis": "Offizieller GitHub-MCP-Server (Remote). Der alte @modelcontextprotocol/server-github ist archiviert — nicht mehr verwenden. GITHUB_PAT = Fine-grained PAT mit minimalen Scopes."
    },
    "dataforseo": {
      "command": "npx",
      "args": [
        "-y",
        "dataforseo-mcp-server"
      ],
      "env": {
        "DATAFORSEO_LOGIN": "${DATAFORSEO_LOGIN}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "_hinweis": "E2E-Tests und Browser-Automatisierung (nur Web-Profile)"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "_hinweis": "Aktuelle Library-Dokumentation direkt im Kontext"
    }
  }
}
