# =============================================================
# ENVIRONMENT VARIABLES — TEMPLATE
# Kopiere diese Datei zu .env.local und fülle die Werte aus
# NIEMALS echte Werte in .env.example eintragen!
# =============================================================

# Datenbank
DATABASE_URL=

# Authentifizierung
AUTH_SECRET=
AUTH_URL=

# --- MCP-Server (nur die behalten, die in .mcp.json aktiv sind) ---

# GitHub — Fine-grained PAT mit minimalen Scopes (offizieller GitHub-MCP-Server)
GITHUB_PAT=

# Supabase (MCP)
SUPABASE_ACCESS_TOKEN=

# DataForSEO (MCP)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Vercel (Deploy — optional)
VERCEL_TOKEN=

# Weitere projekt-spezifische Variablen:
# [KEY]=
