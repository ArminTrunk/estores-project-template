{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "estores": {
      "source": {
        "source": "github",
        "repo": "ArminTrunk/estores-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "estores-core@estores": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.staging)",
      "Read(./**/.env.staging)",
      "Read(./.env.test)",
      "Read(./**/.env.test)",
      "Write(./.env)",
      "Write(./**/.env)",
      "Write(./.env.local)",
      "Write(./**/.env.local)",
      "Write(./.env.*.local)",
      "Write(./**/.env.*.local)",
      "Write(./.env.development)",
      "Write(./**/.env.development)",
      "Write(./.env.production)",
      "Write(./**/.env.production)",
      "Write(./.env.staging)",
      "Write(./**/.env.staging)",
      "Write(./.env.test)",
      "Write(./**/.env.test)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.env.local)",
      "Edit(./**/.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./**/.env.development)",
      "Edit(./.env.production)",
      "Edit(./**/.env.production)",
      "Edit(./.env.staging)",
      "Edit(./**/.env.staging)",
      "Edit(./.env.test)",
      "Edit(./**/.env.test)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)"
    ]
  },
  "fallbackModel": [
    "claude-sonnet-5",
    "claude-haiku-4-5"
  ]
}
