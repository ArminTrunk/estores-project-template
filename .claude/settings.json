{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "estores": {
      "source": {
        "source": "github",
        "repo": "ArminTrunk/estores-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "estores-core@estores": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)"
    ]
  },
  "fallbackModel": [
    "claude-sonnet-5",
    "claude-haiku-4-5"
  ]
}
